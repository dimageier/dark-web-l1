ction(){var m='<h3>Leaderboard</h3><p class="lb-err">Couldn’t load scores.</p>';["introLeaderboard","menuLeaderboard","winLeaderboard"].forEach(function(id){var el=document.getElementById(id);if(el)el.innerHTML=m})})}
function post(pts,lvl){var name=clean(get());if(!name)return Promise.resolve(null);return fetch(root()+"/api/score",{method:"POST",headers:{"Content-Type":"application/json",Accept:"application/json"},body:JSON.stringify({name:name,score:Math.max(0,Math.min(999999,Math.floor(+pts||0))),level:Math.max(1,Math.min(4,Math.floor(+lvl||1)))})}).then(function(r){if(!r.ok)throw 0;return r.json()}).then(function(d){var s=(d&&d.scores)||[];["introLeaderboard","menuLeaderboard","winLeaderboard"].forEach(function(id){paint(document.getElementById(id),s)});return d}).catch(function(){return null})}
function need(el){var n=clean(el&&el.value);if(!n){var st=document.getElementById("nameStatus");if(st){st.textContent="Pick a handle: 2–16 letters, numbers, spaces, _ or -.";st.className="name-status err"}if(el)el.focus();return null}set(n);var s2=document.getElementById("nameStatus");if(s2){s2.textContent="Playing as "+n+".";s2.className="name-status"}return n}
function mount(){
 var intro=document.querySelector("#ovIntro .introcard"),signup=document.getElementById("signupForm");
 if(intro&&!document.getElementById("introName")){var nf=document.createElement("div");nf.className="namefield";nf.innerHTML='<label for="introName">Player name <span class="opt">(required for high score